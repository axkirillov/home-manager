{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "allow",
      "git remote*": "allow",
      "git rev-parse*": "allow",
      "git describe*": "allow",
      "git ls-files*": "allow",
      "git ls-tree*": "allow",
      "git cat-file*": "allow",
      "git blame*": "allow",
      "ls*": "allow",
      "pwd*": "allow",
      "whoami*": "allow",
      "uname*": "allow",
      "date*": "allow",
      "cat*": "allow",
      "head*": "allow",
      "tail*": "allow",
      "wc*": "allow",
      "rg*": "allow",
      "mgrep*": "allow"
    },
    "edit": "ask",
    "webfetch": "allow",
    "question": "allow",
    "mgrep": "allow"
  },
  "agent": {
    "Build": {
      "description": "General-purpose assistant for coding and non-coding tasks.",
      "model": "openai/gpt-5.2",
      "prompt": "You are a general-purpose assistant",
      "tools": {
        "bash": true,
        "edit": true,
        "webfetch": true
      }
    }
  },
  "command": {
    "commit": {
      "template": "Create a git commit",
      "description": "Create a git commit (message optional)",
      "subtask": true
    },
  },
  "mcp": {
    "mgrep": {
      "type": "local",
      "command": ["mgrep", "mcp"],
      "enabled": true
    }
  },
  "instructions": ["**/AGENTS.md"]
}
